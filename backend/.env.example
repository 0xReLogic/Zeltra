# Environment variables for Zeltra
# Copy this to .env and fill in your values

# Run mode: development, staging, production
RUN_MODE=development

# Database
# For migrations/admin tasks, use superuser:
ZELTRA__DATABASE__URL=postgres://postgres:postgres@localhost:5432/zeltra_dev

# For application runtime, use non-superuser (RLS enforced):
# ZELTRA__DATABASE__URL=postgres://zeltra_app:zeltra_app_password@localhost:5432/zeltra_dev
#
# NOTE: The zeltra_app role is created with NOBYPASSRLS, so RLS policies
# are always enforced. FORCE RLS on tables provides additional safety
# in case someone accidentally uses the superuser connection.

# JWT
ZELTRA__JWT__SECRET=your-secret-key-here

# Email (SMTP)
# For development, use MailHog: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
ZELTRA__EMAIL__SMTP_HOST=localhost
ZELTRA__EMAIL__SMTP_PORT=1025
ZELTRA__EMAIL__SMTP_USERNAME=
ZELTRA__EMAIL__SMTP_PASSWORD=
ZELTRA__EMAIL__FROM_EMAIL=noreply@zeltra.app
ZELTRA__EMAIL__FROM_NAME=Zeltra
ZELTRA__EMAIL__FRONTEND_URL=http://localhost:3000

# Logging
RUST_LOG=zeltra=debug,tower_http=debug

# Exchange Rates (Frankfurter API)
# Default: https://api.frankfurter.app (public, no rate limit guarantee)
# Self-hosted: http://localhost:8081 (via docker-compose)
# Docker internal: http://frankfurter:8080
FRANKFURTER_API_URL=https://api.frankfurter.app

# Storage (OpenDAL)
# Options: local, s3, azure, vercel
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./uploads

# S3/R2/Supabase Storage (if STORAGE_PROVIDER=s3)
# STORAGE_S3_BUCKET=zeltra-attachments
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=xxx
# STORAGE_S3_SECRET_ACCESS_KEY=xxx
